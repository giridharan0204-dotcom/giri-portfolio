{
  "entities": {
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "An inquiry submitted through the portfolio contact form.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Sender full name.",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender contact email address.",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "subject": {
          "type": "string",
          "description": "Inquiry subject line.",
          "minLength": 2,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "description": "Inquiry message body.",
          "minLength": 5,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the inquiry was created."
        }
      },
      "required": [
        "fullName",
        "email",
        "subject",
        "message",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/contact_messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ContactMessage"
      },
      "description": "Stores portfolio visitor contact form submissions with admin-only read access."
    }
  }
}
